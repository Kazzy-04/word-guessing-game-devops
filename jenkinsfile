pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                bat '"C:\\Users\\User\\AppData\\Local\\Programs\\Python\\Python310\\python.exe" -m pip install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                bat '"C:\\Users\\User\\AppData\\Local\\Programs\\Python\\Python310\\python.exe" -m pytest -v'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t word-guessing-game:%BUILD_NUMBER% .'
            }

        }
        stage('Tag Docker Image'){
            steps{
                bat 'docker tag word-guessing-game:%BUILD_NUMBER%  171379772639.dkr.ecr.us-east-1.amazonaws.com/word-guessing-game:%BUILD_NUMBER%'
            }
        }
        stage('Push to ECR'){
            steps{
                    bat 'docker push 171379772639.dkr.ecr.us-east-1.amazonaws.com/word-guessing-game:%BUILD_NUMBER%'
            }
    }
}